<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SystemMate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SystemMate">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        Background="{ThemeResource SidebarBackgroundBrush}"
                        OpenPaneLength="200"
                        SelectionChanged="NavView_SelectionChanged"
                        Loaded="NavView_Loaded">

            <NavigationView.PaneHeader>
                <StackPanel Margin="16,20,0,12">
                    <TextBlock Text="SystemMate"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentBlueBrush}" />
                    <TextBlock x:Name="SubtitleText"
                               FontSize="11"
                               Opacity="0.5"
                               Margin="0,2,0,0" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="dashboard" Icon="Home" Content="Dashboard" />
                <NavigationViewItem Tag="cleaner" Content="Cleaner">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA99;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="storage" Content="Storage explorer"><NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Tag="apps" Content="Apps"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Tag="startup" Content="Startup"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7E8;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Tag="browsers" Content="Browser extensions"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Tag="performance" Content="Performance"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Tag="tools" Content="Windows tools"><NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Tag="history" Icon="List" Content="History" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
