<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Backgrounds ───────────────────────────────── -->
    <Color x:Key="AppBackgroundColor">#FF0F0F13</Color>
    <Color x:Key="CardBackgroundColor">#FF1A1A22</Color>
    <Color x:Key="CardBorderColor">#FF2A2A3A</Color>
    <Color x:Key="SidebarBackgroundColor">#FF0D0D11</Color>

    <!-- ── Accent ────────────────────────────────────── -->
    <Color x:Key="AccentBlueColor">#FF2563EB</Color>
    <Color x:Key="AccentBlueHoverColor">#FF3B82F6</Color>
    <Color x:Key="AccentGreenColor">#FF22C55E</Color>
    <Color x:Key="AccentAmberColor">#FFF59E0B</Color>
    <Color x:Key="AccentRedColor">#FFEF4444</Color>

    <!-- ── Text ──────────────────────────────────────── -->
    <Color x:Key="TextPrimaryColor">#FFF5F5F5</Color>
    <Color x:Key="TextSecondaryColor">#FF9CA3AF</Color>
    <Color x:Key="TextMutedColor">#FF6B7280</Color>

    <!-- ── Brushes ────────────────────────────────────  -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

</ResourceDictionary>
