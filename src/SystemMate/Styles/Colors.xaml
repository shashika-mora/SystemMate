<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF5F7FB" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#FFDCE2EC" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFEDF1F7" />
            <SolidColorBrush x:Key="ControlFillBrush" Color="#FFF0F3F9" />
            <SolidColorBrush x:Key="SubtleFillBrush" Color="#FFE4F2E9" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF182437" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF475569" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FF5C6B80" />
            <SolidColorBrush x:Key="AccentBlueBrush" Color="#FF1D4ED8" />
            <SolidColorBrush x:Key="AccentGreenBrush" Color="#FF18703A" />
            <SolidColorBrush x:Key="AccentAmberBrush" Color="#FF8A5200" />
            <SolidColorBrush x:Key="AccentRedBrush" Color="#FFB42332" />
            <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#FF1D4ED8" />
            <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#FFB42332" />
            <SolidColorBrush x:Key="AccentButtonForegroundBrush" Color="#FFFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF101722" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF192332" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#FF344155" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FF121C29" />
            <SolidColorBrush x:Key="ControlFillBrush" Color="#FF243246" />
            <SolidColorBrush x:Key="SubtleFillBrush" Color="#FF18362A" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF3F6FC" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC0CCDD" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FFA6B5CA" />
            <SolidColorBrush x:Key="AccentBlueBrush" Color="#FF88B4FF" />
            <SolidColorBrush x:Key="AccentGreenBrush" Color="#FF70D9A0" />
            <SolidColorBrush x:Key="AccentAmberBrush" Color="#FFFFC76B" />
            <SolidColorBrush x:Key="AccentRedBrush" Color="#FFFF8F9B" />
            <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#FF2963D9" />
            <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#FFB82B40" />
            <SolidColorBrush x:Key="AccentButtonForegroundBrush" Color="#FFFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ControlFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="SubtleFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentBlueBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="AccentGreenBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentAmberBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentRedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
