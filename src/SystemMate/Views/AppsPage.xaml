<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SystemMate.Views.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:SystemMate.Models"
      Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="32,28,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="Apps" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Find desktop software, compare versions and sizes, and manage installations in Windows." Style="{StaticResource BodyStyle}" />
            <TextBlock Text="Desktop applications reported by installers. Store apps and portable software may not appear. Reported dates can reflect servicing, and sizes are estimates." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search name, publisher, or version" TextChanged="SearchChanged" AutomationProperties.Name="Search desktop applications" />
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" Click="RefreshClick" />
            <Button Grid.Column="2" x:Name="ExportButton" Content="Export CSV" Click="ExportClick" IsEnabled="False" />
            <Button Grid.Column="3" Content="Manage in Windows" Click="ManageClick" />
        </Grid>
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Padding="12,4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Application" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Publisher" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Version" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Reported size" Foreground="{ThemeResource TextSecondaryBrush}" />
                </Grid>
                <ListView Grid.Row="1" x:Name="AppsList" ItemsSource="{x:Bind Items}" SelectionChanged="SelectionChanged" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AppInventoryItem">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Scope}" Style="{StaticResource CaptionStyle}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Publisher}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Version}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind SizeDisplay}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Spacing="8">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Text="Ready to read desktop applications." Style="{StaticResource BodyStyle}" />
            <TextBlock x:Name="SelectionText" Text="Select an application for its reported date and location. Uninstall and repair actions open in Windows." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" MaxHeight="72" />
            <TextBlock x:Name="WarningText" Foreground="{ThemeResource AccentAmberBrush}" TextWrapping="Wrap" MaxHeight="60" />
        </StackPanel>
    </Grid>
</Page>
