<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemMate.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SystemMate.Models"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer Padding="32,28,32,32">
        <StackPanel Spacing="24">

            <!-- ── Header ─────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="History" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource BodyStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource QuickActionButtonStyle}"
                            Command="{x:Bind ViewModel.ExportCsvCommand}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Save" />
                            <TextBlock Text="Export CSV" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickActionButtonStyle}"
                            Command="{x:Bind ViewModel.ClearHistoryCommand}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Delete" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Loading ────────────────────────────────────────── -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="32" Height="32"
                          HorizontalAlignment="Center"
                          Foreground="{StaticResource AccentBlueBrush}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- ── Empty state ────────────────────────────────────── -->
            <Border Style="{StaticResource ContentCardStyle}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" Padding="40" Spacing="12">
                    <FontIcon Glyph="&#xE81C;" FontSize="48"
                              Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="No cleanup history yet"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Run a scan from the Cleaner to get started."
                               Style="{StaticResource BodyStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── Session list ───────────────────────────────────── -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CleanupSession">
                        <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,0,12">
                            <StackPanel Spacing="12">

                                <!-- Session header -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{x:Bind StartedAt}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind SessionId}"
                                                   Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind TotalSizeDisplay}"
                                                       FontWeight="Bold" FontSize="16"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="freed" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind FilesDeleted}"
                                                       FontWeight="Bold" FontSize="16"
                                                       Foreground="{StaticResource AccentGreenBrush}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="deleted" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind FilesErrored}"
                                                       FontWeight="Bold" FontSize="16"
                                                       Foreground="{StaticResource AccentRedBrush}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="errors" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Individual file records -->
                                <Expander Header="Show file details"
                                          HorizontalAlignment="Stretch"
                                          Visibility="{x:Bind ShowFileDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{x:Bind Records}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:OperationRecord">
                                                <Grid Padding="0,4" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="60" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{x:Bind Category}"
                                                               Style="{StaticResource CaptionStyle}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind FilePath}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind SizeDisplay}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
