<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemMate.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer Padding="32,28,32,32">
        <StackPanel Spacing="24" MaxWidth="680" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <!-- ── Appearance ──────────────────────────────────────── -->
            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="APPEARANCE"
                               Style="{StaticResource SectionLabelStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Theme"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       FontWeight="Medium" />
                            <TextBlock Text="Choose how SystemMate looks"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{x:Bind ViewModel.Themes}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Behavior ───────────────────────────────────────── -->
            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="BEHAVIOR"
                               Style="{StaticResource SectionLabelStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Confirm before deleting"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       FontWeight="Medium" />
                            <TextBlock Text="Show a dialog before any file is removed"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.ConfirmBeforeDelete, Mode=TwoWay}"
                                      OnContent="" OffContent=""
                                      VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource CardBorderBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Show file details in history"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       FontWeight="Medium" />
                            <TextBlock Text="Expand individual file paths per session"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.ShowFileDetails, Mode=TwoWay}"
                                      OnContent="" OffContent=""
                                      VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Data ───────────────────────────────────────────── -->
            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="DATA"
                               Style="{StaticResource SectionLabelStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Open data folder"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       FontWeight="Medium" />
                            <TextBlock Text="Find your saved settings, history, logs and startup backups"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource QuickActionButtonStyle}"
                                Command="{x:Bind ViewModel.OpenDataFolderCommand}"
                                Padding="12,8">
                            <SymbolIcon Symbol="OpenWith" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── About ──────────────────────────────────────────── -->
            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="ABOUT"
                               Style="{StaticResource SectionLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="SystemMate"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{ThemeResource AccentBlueBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.AppVersion}"
                                   FontSize="18"
                                   Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="Understand your PC, recover space, and manage everyday maintenance."
                               Style="{StaticResource BodyStyle}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
