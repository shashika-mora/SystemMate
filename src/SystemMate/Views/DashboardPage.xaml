<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemMate.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SystemMate.ViewModels"
    xmlns:controls="using:SystemMate.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer Padding="32,28,32,32">
        <StackPanel Spacing="24">

            <!-- ── Header ─────────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="GreetingText"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="A clear view of your PC. Choose what to inspect or improve next."
                               Style="{StaticResource BodyStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        CornerRadius="20"
                        Background="{ThemeResource ControlFillBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Live overview"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   FontSize="12"
                                   FontWeight="Medium" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Metric Cards ──────────────────────────────────────── -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Border Style="{StaticResource MetricCardStyle}" Grid.Column="0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CpuUsage, Mode=OneWay, Converter={StaticResource PercentConverter}}"
                                   Style="{StaticResource MetricValueStyle}" />
                        <ProgressBar Value="{x:Bind ViewModel.CpuUsage, Mode=OneWay}"
                                     Maximum="100"
                                     Height="3"
                                     Foreground="{ThemeResource AccentBlueBrush}"
                                     Background="{ThemeResource CardBorderBrush}" />
                        <TextBlock Text="Processor" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Border>

                <!-- Memory -->
                <Border Style="{StaticResource MetricCardStyle}" Grid.Column="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="MEMORY" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.RamDisplay, Mode=OneWay}"
                                   Style="{StaticResource MetricValueStyle}"
                                   FontSize="20" />
                        <ProgressBar Value="{x:Bind ViewModel.RamPercent, Mode=OneWay}"
                                     Maximum="100"
                                     Height="3"
                                     Foreground="{ThemeResource AccentBlueBrush}"
                                     Background="{ThemeResource CardBorderBrush}" />
                        <TextBlock Text="RAM used" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Border>

                <!-- Storage -->
                <Border Style="{StaticResource MetricCardStyle}" Grid.Column="2">
                    <StackPanel Spacing="8">
                        <TextBlock Text="STORAGE" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StorageDisplay, Mode=OneWay}"
                                   Style="{StaticResource MetricValueStyle}"
                                   FontSize="20" />
                        <ProgressBar Value="{x:Bind ViewModel.DiskPercent, Mode=OneWay}"
                                     Maximum="100"
                                     Height="3"
                                     Foreground="{ThemeResource AccentBlueBrush}"
                                     Background="{ThemeResource CardBorderBrush}" />
                        <TextBlock Text="Drive C:" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Border>

                <!-- Boot Time -->
                <Border Style="{StaticResource MetricCardStyle}" Grid.Column="3">
                    <StackPanel Spacing="8">
                        <TextBlock Text="UPTIME" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.BootTimeDisplay, Mode=OneWay}"
                                   Style="{StaticResource MetricValueStyle}" />
                        <ProgressBar Value="0" Maximum="100" Height="3"
                                     Background="{ThemeResource CardBorderBrush}" />
                        <TextBlock Text="Since last restart" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── System Health + Quick Actions ───────────────────── -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- System Health -->
                <Border Style="{StaticResource ContentCardStyle}" Grid.Column="0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Explore your PC"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="Inspect the details before deciding what to change."
                                   Style="{StaticResource CaptionStyle}" />

                        <StackPanel Spacing="12">
                            <Button Content="Installed apps" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="apps" Click="ExploreClick" />
                            <Button Content="Processes &amp; power plans" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="performance" Click="ExploreClick" />
                            <Button Content="Browser extensions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="browsers" Click="ExploreClick" />
                            <Button Content="Windows, drivers &amp; network tools" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="tools" Click="ExploreClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Border Style="{StaticResource ContentCardStyle}" Grid.Column="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Quick actions"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="Start with a scan. Changes are reviewed separately."
                                   Style="{StaticResource CaptionStyle}" />

                        <StackPanel Spacing="8">
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Click="ScanJunkClick">
                                <StackPanel>
                                    <TextBlock Text="Scan junk files"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               FontWeight="Medium" />
                                    <TextBlock Text="Find what can be removed"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Click="AnalyzeStorageClick">
                                <StackPanel>
                                    <TextBlock Text="Analyze storage"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               FontWeight="Medium" />
                                    <TextBlock Text="Find large files and exact duplicates"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Click="ReviewStartupClick">
                                <StackPanel>
                                    <TextBlock Text="Review startup"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               FontWeight="Medium" />
                                    <TextBlock Text="Review what runs when you sign in"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── System Info ──────────────────────────────────────── -->
            <Border Style="{StaticResource ContentCardStyle}">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="MACHINE" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.MachineName, Mode=OneWay}"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   FontWeight="Medium" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="OPERATING SYSTEM" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.OsVersion, Mode=OneWay}"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   FontWeight="Medium"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="PROCESSOR" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CpuName, Mode=OneWay}"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   FontWeight="Medium"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
