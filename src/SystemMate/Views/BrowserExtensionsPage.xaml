<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SystemMate.Views.BrowserExtensionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:SystemMate.Models"
      Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="32,28,32,24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="Browser extensions" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Review installed extensions and their listed permissions before deciding what to keep." Style="{StaticResource BodyStyle}" />
            <TextBlock Text="Reads extension metadata in standard Chrome, Edge, Brave, Vivaldi and Firefox profiles. Portable/custom locations may be absent. Saved files do not establish current enabled state or granted permissions." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search extension, browser, profile, or permission" TextChanged="SearchChanged" AutomationProperties.Name="Search browser extensions" />
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Read extensions" Click="RefreshClick" />
            <Button Grid.Column="2" x:Name="ExportButton" Content="Export CSV" Click="ExportClick" IsEnabled="False" />
            <Button Grid.Column="3" x:Name="ManagerButton" Content="Copy manager address" Click="CopyManagerClick" IsEnabled="False" />
        </Grid>
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Padding="12,4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Extension" Foreground="{ThemeResource TextSecondaryBrush}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Browser / profile" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Version" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Permissions" Foreground="{ThemeResource TextSecondaryBrush}" />
                </Grid>
                <ListView Grid.Row="1" x:Name="ExtensionsList" ItemsSource="{x:Bind Items}" SelectionChanged="SelectionChanged" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BrowserExtensionItem">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Status}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{x:Bind Browser}" /><TextBlock Text="{x:Bind Profile}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Version}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind PermissionSummary}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Spacing="8">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Text="Choose Read extensions to inspect local metadata. Cookies, passwords and browsing history are not read." Style="{StaticResource BodyStyle}" />
            <Expander Header="Selected extension details" HorizontalAlignment="Stretch">
                <ScrollViewer MaxHeight="160"><TextBlock x:Name="SelectionText" Text="Select an extension to see its identifier, metadata source and permission list." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></ScrollViewer>
            </Expander>
            <TextBlock x:Name="WarningText" Foreground="{ThemeResource AccentAmberBrush}" TextWrapping="Wrap" MaxHeight="60" />
        </StackPanel>
    </Grid>
</Page>
