<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemMate.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SystemMate.Models"
    Background="{ThemeResource AppBackgroundBrush}">
    <ScrollViewer Padding="32,28,32,32">
        <StackPanel Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock Text="Storage explorer" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Find the files taking up space and compare duplicate contents inside a folder you choose."
                           Style="{StaticResource BodyStyle}" />
            </StackPanel>

            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Selected folder" Style="{StaticResource SectionLabelStyle}" />
                    <TextBox x:Name="FolderPathBox" IsReadOnly="True" PlaceholderText="Choose a folder to begin"
                             AutomationProperties.Name="Selected folder" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ChooseFolderButton" Content="Choose folder" Click="ChooseFolderClick" />
                        <Button x:Name="AnalyzeButton" Content="Analyze" Click="AnalyzeClick" IsEnabled="False"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Name="CancelButton" Content="Cancel" Click="CancelClick" IsEnabled="False" />
                        <Button x:Name="ExportButton" Content="Export CSV" Click="ExportClick" IsEnabled="False" />
                    </StackPanel>
                    <ToggleSwitch x:Name="DuplicatesToggle" Header="Compare duplicate file contents" IsOn="True"
                                  OnContent="SHA-256 comparison enabled" OffContent="Measure sizes only" />
                    <TextBlock Text="Linked folders are skipped. No files are deleted. Logical sizes can differ from space on disk; hard links and cloud files may affect results. Duplicate comparison reads file contents and can download cloud-only files."
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="StatusText" Text="Ready. Choose a folder to analyze." TextWrapping="Wrap"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <ProgressBar x:Name="ScanProgress" IsIndeterminate="False" Visibility="Collapsed" />
                    <TextBlock x:Name="CurrentPathText" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextMutedBrush}" />
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <ComboBox x:Name="ResultSelector" Header="Explore results" SelectedIndex="0"
                      SelectionChanged="ResultSelectionChanged" Width="260" HorizontalAlignment="Left">
                <ComboBoxItem Content="Largest files" />
                <ComboBoxItem Content="Folders" />
                <ComboBoxItem Content="File types" />
                <ComboBoxItem Content="Duplicate contents" />
            </ComboBox>

            <ListView x:Name="FilesList" MaxHeight="480" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:StorageFile">
                        <Grid ColumnSpacing="16" Padding="4,8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind FullPath}" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind FullPath}"
                                           Foreground="{ThemeResource TextMutedBrush}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind SizeDisplay}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource AccentBlueBrush}" />
                            <Button Grid.Column="2" Content="Show folder" Tag="{x:Bind FullPath}" Click="ShowFolderClick" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="FoldersList" MaxHeight="480" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:StorageBreakdown">
                        <StackPanel Spacing="4" Padding="4,8">
                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Summary}" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="TypesList" MaxHeight="480" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:StorageBreakdown">
                        <StackPanel Spacing="4" Padding="4,8">
                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Summary}" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="DuplicatesList" MaxHeight="480" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:StorageDuplicateGroup">
                        <StackPanel Spacing="6" Padding="4,10">
                            <TextBlock Text="{x:Bind Summary}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind PathsDisplay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{x:Bind Sha256}" Foreground="{ThemeResource TextMutedBrush}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Largest files, folders and file types show the top 100 entries. Analysis stops at 100,000 files or 200,000 entries. Duplicate groups show up to 500 groups; empty files are excluded. Results describe the scan time and may change afterward."
                       Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
