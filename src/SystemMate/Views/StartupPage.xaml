<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SystemMate.Views.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:SystemMate.Models"
      Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="32,28,32,24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="Startup" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Review what starts at sign-in. Disable current-user startup entries with a saved backup and restore them later." Style="{StaticResource BodyStyle}" />
            <TextBlock Text="Includes Run, RunOnce and Startup folders. Scheduled tasks, services and packaged-app startup are not included. Resource impact is not measured." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search name, source, or command" TextChanged="SearchChanged" AutomationProperties.Name="Search startup entries" />
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" Click="RefreshClick" />
            <Button Grid.Column="2" x:Name="ExportButton" Content="Export CSV" Click="ExportClick" IsEnabled="False" />
            <Button Grid.Column="3" Content="Windows startup settings" Click="ManageClick" />
        </Grid>
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Padding="12,4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Entry" Foreground="{ThemeResource TextSecondaryBrush}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Source" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Status" Foreground="{ThemeResource TextSecondaryBrush}" />
                </Grid>
                <ListView Grid.Row="1" x:Name="StartupList" ItemsSource="{x:Bind Items}" SelectionChanged="SelectionChanged" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:StartupItem">
                            <Grid Padding="0,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Source}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Status}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Spacing="8">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Text="Ready to read startup entries." Style="{StaticResource BodyStyle}" />
            <TextBlock x:Name="SelectionText" Text="Select an entry to review its command. SystemMate changes only current-user Run entries; other entries can be managed in Windows." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" MaxHeight="68" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="DisableButton" Content="Disable selected" Click="DisableClick" IsEnabled="False" />
                <Button x:Name="RestoreButton" Content="Restore selected" Click="RestoreClick" IsEnabled="False" />
                <TextBlock Text="Changes affect future sign-ins, not apps already running." Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="WarningText" Foreground="{ThemeResource AccentAmberBrush}" TextWrapping="Wrap" MaxHeight="60" />
        </StackPanel>
    </Grid>
</Page>
