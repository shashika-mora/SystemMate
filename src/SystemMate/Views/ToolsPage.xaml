<Page x:Class="SystemMate.Views.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:SystemMate.Models"
      Background="{ThemeResource AppBackgroundBrush}">
    <ScrollViewer Padding="32,28">
        <StackPanel Spacing="20">
            <TextBlock Text="Windows tools" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Inspect your PC, troubleshoot Windows, and reach the settings that matter." Style="{StaticResource BodyStyle}" />
            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" Message="Choose a tool. System changes require review and confirmation." />
            <Pivot>
                <PivotItem Header="Maintenance &amp; network">
                    <StackPanel Spacing="16" Padding="0,16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="CategoryPicker" Header="Category" SelectionChanged="CategoryChanged" HorizontalAlignment="Stretch" />
                            <TextBox x:Name="ToolSearch" Grid.Column="1" Header="Find a tool" PlaceholderText="Search tools" TextChanged="ToolSearchChanged" />
                        </Grid>
                        <ItemsControl x:Name="ToolList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SystemTool">
                                    <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,0,10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource BodyStyle}" />
                                            <TextBlock Text="{x:Bind AccessDescription}" Style="{StaticResource CaptionStyle}" />
                                            <Button Content="{x:Bind ActionLabel}" Click="RunToolClick" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Last tool output" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <Button x:Name="CancelToolButton" Content="Cancel running check" Click="CancelToolClick" IsEnabled="False" />
                        <TextBox x:Name="OutputText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" MaxHeight="360" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Tool output" />
                    </StackPanel>
                </PivotItem>
                <PivotItem Header="Drivers, services &amp; recovery">
                    <StackPanel Spacing="16" Padding="0,16">
                        <ComboBox x:Name="InventoryPicker" Header="Inspect" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="InventoryKindChanged">
                            <ComboBoxItem Content="Device drivers" Tag="drivers"/>
                            <ComboBoxItem Content="Windows services" Tag="services"/>
                            <ComboBoxItem Content="Restore points" Tag="restore"/>
                        </ComboBox>
                        <TextBlock x:Name="InventoryDescription" Style="{StaticResource BodyStyle}" Text="View installed driver versions and providers. An older date alone does not mean a driver needs updating." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="LoadInventoryButton" Content="Refresh inventory" Click="LoadInventoryClick" />
                            <Button x:Name="ManageInventoryButton" Content="Open Device Manager" Click="ManageInventoryClick" />
                            <Button x:Name="ExportInventoryButton" Content="Export CSV" Click="ExportInventoryClick" IsEnabled="False" />
                        </StackPanel>
                        <TextBox x:Name="InventorySearch" PlaceholderText="Search this inventory" TextChanged="InventorySearchChanged" AutomationProperties.Name="Search inventory" />
                        <TextBlock x:Name="InventoryStatusText" Style="{StaticResource CaptionStyle}" Text="Select Refresh inventory to read this PC." />
                        <ItemsControl x:Name="InventoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:InventoryEntry">
                                    <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodyStyle}"/>
                                            <TextBlock Text="{x:Bind State}" Style="{StaticResource CaptionStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </PivotItem>
                <PivotItem Header="Windows settings">
                    <StackPanel Spacing="12" Padding="0,16">
                        <TextBlock Text="Continue in Windows to review and apply these settings." Style="{StaticResource BodyStyle}" />
                        <Button Content="Windows Update &amp; optional drivers" Tag="ms-settings:windowsupdate" Click="OpenSettingsClick" />
                        <Button Content="Storage &amp; Storage Sense" Tag="ms-settings:storagesense" Click="OpenSettingsClick" />
                        <Button Content="Open Recycle Bin" Click="OpenRecycleBinClick" />
                        <Button Content="Recovery options" Tag="ms-settings:recovery" Click="OpenSettingsClick" />
                        <Button Content="Network &amp; internet" Tag="ms-settings:network-status" Click="OpenSettingsClick" />
                        <Button Content="Notifications" Tag="ms-settings:notifications" Click="OpenSettingsClick" />
                        <Button Content="Default apps" Tag="ms-settings:defaultapps" Click="OpenSettingsClick" />
                        <Button Content="Gaming &amp; Game Mode" Tag="ms-settings:gaming-gamemode" Click="OpenSettingsClick" />
                        <Button Content="Privacy &amp; diagnostics" Tag="ms-settings:privacy-feedback" Click="OpenSettingsClick" />
                        <Button Content="Windows appearance" Tag="ms-settings:personalization" Click="OpenSettingsClick" />
                    </StackPanel>
                </PivotItem>
            </Pivot>
        </StackPanel>
    </ScrollViewer>
</Page>
